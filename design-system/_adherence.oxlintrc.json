        "message": "<Container> size must be one of 'sm' | 'md' | 'lg' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|primaryLabel|secondaryLabel|variant|key|ref|className|style|children)$/]",
