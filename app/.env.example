# PostgreSQL (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional transactional email (Resend). Without this, emails log to the server console.
RESEND_API_KEY=
EMAIL_FROM=Doxcta AI <onboarding@resend.dev>

# AI invoice extraction + assistant (optional in dev — mock extract used if unset)
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# Vercel Blob for invoice originals (optional — local placeholder used if unset)
BLOB_READ_WRITE_TOKEN=

# Stripe billing (optional — selecting a plan activates it in-app without Stripe when unset)
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=

# Seed script
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-now
SUPER_ADMIN_NAME=Super Admin
